# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# --- Required ---

# GitHub Personal Access Token with repo:read scope
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Secret used to validate incoming GitHub webhook payloads
# Generate with: openssl rand -hex 32
WEBHOOK_SECRET=your_webhook_secret_here

# --- Optional ---

# Base URL of the Argo Workflows UI.
# When set, PR status checks include a direct link to the workflow run.
# Example: https://argo.your-domain.com
ARGO_UI_BASE_URL=

# Port the HTTP server listens on (default: 8080)
PORT=8080

# Kubernetes namespace where Argo Workflows will be submitted (default: argo)
ARGO_NAMESPACE=argo

# Directory inside each repo containing the pipeline definition (default: .argo)
PIPELINE_DIR=.argo

# Comma-separated list of repos allowed to trigger workflows.
# Leave empty to allow all repos.
# Example: ALLOWED_REPOS=myorg/api,myorg/frontend
ALLOWED_REPOS=

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# Path to kubeconfig file for local development.
# Leave empty when running inside Kubernetes (uses in-cluster config).
# KUBECONFIG=/home/user/.kube/config
